{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/contracts/benchmark-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "platform", "mode", "status", "isolation", "model_invoked", "verifiers_executed"],
  "properties": {
    "schema": {"const": 1},
    "contract": {"const": "codex-baseline-benchmark/v1"},
    "platform": {"enum": ["linux", "wsl2", "native-windows"]},
    "mode": {"enum": ["live-paired", "live-containment-canary", "static-contract-only"]},
    "status": {"enum": ["running", "completed"]},
    "isolation": {"type": "string"},
    "model_invoked": {"type": "boolean"},
    "verifiers_executed": {"type": "boolean"},
    "created": {"type": "string", "format": "date-time"},
    "codex": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "source_dirty": {"type": ["boolean", "null"]},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codex_binary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_binary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "auth": {"type": "string"},
    "tool_network_target": {"type": "string"},
    "account_service_tier": {"type": "string"},
    "resource_profile": {"type": "string"},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "live-containment-canary"}},
        "required": ["mode"]
      },
      "then": {
        "required": ["created", "codex", "model", "source_revision", "source_dirty", "source_hash", "codex_binary_hash", "node_binary_hash", "auth", "tool_network_target", "resource_profile"],
        "properties": {
          "platform": {"enum": ["linux", "wsl2"]},
          "isolation": {"const": "os-sandboxed-local-cgroup"},
          "model_invoked": {"const": true},
          "verifiers_executed": {"const": false},
          "auth": {"const": "dedicated-api-key-stdin-pipe"},
          "tool_network_target": {"const": "loopback-only"},
          "resource_profile": {"const": "user-cgroup-memory2g-swap0-tasks128-cpu200-runtime-bounded-tmpfs"}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "live-paired"}}, "required": ["mode"]},
      "then": {
        "required": ["created", "codex", "model", "source_revision", "source_dirty", "source_hash", "manifest_hash", "codex_binary_hash", "node_binary_hash", "auth", "account_service_tier", "resource_profile"],
        "properties": {
          "platform": {"enum": ["linux", "wsl2"]},
          "isolation": {"const": "os-sandboxed-local-cgroup"},
          "model_invoked": {"const": true},
          "verifiers_executed": {"const": true},
          "auth": {"const": "dedicated-api-key-stdin-pipe"},
          "resource_profile": {"const": "user-cgroup-memory2g-swap0-tasks128-cpu200-runtime-bounded-tmpfs"}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "static-contract-only"}}, "required": ["mode"]},
      "then": {
        "required": ["tasks", "limitations"],
        "properties": {
          "platform": {"const": "native-windows"},
          "status": {"const": "completed"},
          "isolation": {"const": "not-applicable-no-worker"},
          "model_invoked": {"const": false},
          "verifiers_executed": {"const": false}
        }
      }
    }
  ]
}
