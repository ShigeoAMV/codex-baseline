{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/contracts/operations-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "owned_text_encoding", "owned_line_endings", "transaction_states", "object_states", "operations", "objects", "reports"],
  "properties": {
    "schema": {"const": 1},
    "contract": {"const": "codex-baseline-operations/v1"},
    "owned_text_encoding": {"const": "utf-8-no-bom"},
    "owned_line_endings": {"const": "lf"},
    "transaction_states": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"const": "planned"}, {"const": "prepared"}, {"const": "committing"},
        {"const": "recovering"}, {"const": "committed"}, {"const": "rolled-back"}
      ],
      "items": false
    },
    "object_states": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "prefixItems": [
        {"const": "planned"}, {"const": "prepared"}, {"const": "moving-old"},
        {"const": "old-moved"}, {"const": "new-moved"}, {"const": "committed"},
        {"const": "unchanged"}, {"const": "rolled-back"}
      ],
      "items": false
    },
    "operations": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"const": "install"}, {"const": "update"}, {"const": "rollback"}, {"const": "uninstall"}
      ],
      "items": false
    },
    "objects": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"const": {"id":"00","kind":"block","root":"codex_home","destination":"AGENTS.active.md","source":"baseline/global/AGENTS.block.md"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"10","kind":"tree","root":"agents_home","destination":"skills/codex-baseline-repo-onboarding","source":"baseline/skills/codex-baseline-repo-onboarding"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"11","kind":"tree","root":"agents_home","destination":"skills/codex-baseline-deep-work","source":"baseline/skills/codex-baseline-deep-work"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"12","kind":"tree","root":"agents_home","destination":"skills/codex-baseline-conformance-review","source":"baseline/skills/codex-baseline-conformance-review"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"13","kind":"tree","root":"agents_home","destination":"skills/codex-baseline-retrospective","source":"baseline/skills/codex-baseline-retrospective"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"20","kind":"file","root":"codex_home","destination":"agents/codex-baseline-reviewer.toml","source":"baseline/agents/codex-baseline-reviewer.toml"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"30","kind":"tree","root":"codex_home","destination":"codex-baseline/runtime","source":"generated/runtime"}}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": {"id":"31","kind":"file","root":"home","destination":".local/bin/codex-baseline{platform-extension}","source":"generated/wrapper"}}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "root", "destination", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^(00|10|11|12|13|20|30|31)$"},
          "kind": {"enum": ["block", "file", "tree"]},
          "root": {"enum": ["home", "codex_home", "agents_home"]},
          "destination": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "reports": {
      "type": "object", "additionalProperties": false,
      "required": ["doctor", "onboarding", "benchmark"],
      "properties": {
        "doctor": {"const": "codex-baseline-doctor/v1"},
        "onboarding": {"const": "codex-baseline-onboarding/v1"},
        "benchmark": {"const": "codex-baseline-benchmark/v1"}
      }
    }
  }
}
