{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/contracts/benchmark-summary-v1.schema.json",
  "type": "object",
  "required": ["schema", "contract", "comparison", "runs", "pairs", "by_arm", "paired_outcomes", "by_task", "inference", "limitations"],
  "properties": {
    "schema": {"const": 1},
    "contract": {"const": "codex-baseline-benchmark-summary/v1"},
    "comparison": {"const": "paired-vanilla-vs-baseline"},
    "runs": {"type": "integer", "minimum": 2},
    "pairs": {"type": "integer", "minimum": 1},
    "by_arm": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["arm", "runs", "passes", "pass_rate", "median_elapsed_ms", "input_tokens", "output_tokens", "commands", "changed_files", "unnecessary_files", "failed_command_events", "subagent_events"]}},
    "paired_outcomes": {"type": "object", "required": ["both_pass", "baseline_only_pass", "vanilla_only_pass", "neither_pass"]},
    "by_task": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["task", "class", "repetitions", "vanilla_pass_rate", "baseline_pass_rate", "pass_rate_delta", "paired"]}},
    "inference": {"type": "object", "required": ["confidence_interval", "reason"], "properties": {"confidence_interval": {"type": "null"}, "reason": {"type": "string"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
