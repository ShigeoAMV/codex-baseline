{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/contracts/routing-summary-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "execution_profile", "source_hash", "repetitions", "routing", "behavior"],
  "properties": {
    "schema": {"const": 2},
    "contract": {"const": "codex-baseline-routing-summary/v2"},
    "execution_profile": {"const": "auto-evaluation"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repetitions": {"type": "integer", "minimum": 1},
    "routing": {"$ref": "#/$defs/group"},
    "behavior": {"$ref": "#/$defs/group"}
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "passes", "by_case"],
      "properties": {
        "runs": {"type": "integer", "minimum": 1},
        "passes": {"type": "integer", "minimum": 0},
        "by_case": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "runs", "passes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "runs": {"type": "integer", "minimum": 1},
              "passes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
