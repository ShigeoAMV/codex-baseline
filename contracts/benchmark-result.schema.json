{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/contracts/benchmark-result-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "class", "arm", "repetition", "pass", "process_exit", "verifier_exit", "elapsed_ms", "turns", "commands", "file_changes", "changed_files", "unnecessary_files", "changed_paths", "unnecessary_paths", "failed_command_events", "subagent_events", "input_tokens", "output_tokens", "baseline_layer_bytes", "retry_count", "review_findings", "isolation", "source_hash", "layer_hash", "fixture_hash", "prompt_hash", "verifier_hash"],
  "properties": {
    "schema": {"const": 1},
    "task": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "class": {"enum": ["small", "medium", "large", "risk-sensitive"]},
    "arm": {"enum": ["vanilla", "baseline"]},
    "repetition": {"type": "integer", "minimum": 1},
    "pass": {"type": "boolean"},
    "process_exit": {"type": "integer", "minimum": 0},
    "verifier_exit": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "turns": {"type": "integer", "minimum": 0},
    "commands": {"type": "integer", "minimum": 0},
    "file_changes": {"type": "integer", "minimum": 0},
    "changed_files": {"type": "integer", "minimum": 0},
    "unnecessary_files": {"type": "integer", "minimum": 0},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unnecessary_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "failed_command_events": {"type": "integer", "minimum": 0},
    "subagent_events": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "baseline_layer_bytes": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "null"},
    "review_findings": {"type": "null"},
    "isolation": {"const": "os-sandboxed-local-cgroup"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layer_hash": {"type": "string", "pattern": "^(vanilla|[0-9a-f]{64})$"},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"pass": {"const": true}}, "required": ["pass"]},
      "then": {"properties": {"process_exit": {"const": 0}, "verifier_exit": {"const": 0}}}
    }
  ]
}
