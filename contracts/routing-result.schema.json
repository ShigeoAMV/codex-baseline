{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/contracts/routing-result-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "id", "repetition", "pass", "process_exit", "elapsed_ms", "turns", "commands", "file_changes", "input_tokens", "output_tokens", "source_hash", "prompt_hash", "expected", "actual"],
  "properties": {
    "schema": {"const": 1},
    "contract": {"const": "codex-baseline-routing-result/v1"},
    "id": {"enum": ["lean-typo", "lean-readonly-diagnosis", "lean-two-file-fix", "strict-feature", "strict-readonly-architecture", "deep-architecture-implementation", "deep-auth-migration", "onboarding", "conformance", "retrospective"]},
    "repetition": {"type": "integer", "minimum": 1},
    "pass": {"type": "boolean"},
    "process_exit": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "turns": {"type": "integer", "minimum": 0},
    "commands": {"type": "integer", "minimum": 0},
    "file_changes": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "high_risk", "skill"],
      "properties": {
        "workflow": {"enum": ["LEAN", "STRICT", "DEEP"]},
        "high_risk": {"type": "boolean"},
        "skill": {"type": ["string", "null"]}
      }
    },
    "actual": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow", "high_risk", "selected_skills", "reason"],
          "properties": {
            "workflow": {"enum": ["LEAN", "STRICT", "DEEP"]},
            "high_risk": {"type": "boolean"},
            "selected_skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"pass": {"const": true}}, "required": ["pass"]},
      "then": {
        "properties": {
          "process_exit": {"const": 0},
          "turns": {"minimum": 1},
          "commands": {"const": 0},
          "file_changes": {"const": 0},
          "actual": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "lean-typo"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "LEAN"}, "high_risk": {"const": false}, "skill": {"type": "null"}}},
        "actual": {"properties": {"workflow": {"const": "LEAN"}, "high_risk": {"const": false}, "selected_skills": {"maxItems": 0}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "lean-readonly-diagnosis"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "LEAN"}, "high_risk": {"const": false}, "skill": {"type": "null"}}},
        "actual": {"properties": {"workflow": {"const": "LEAN"}, "high_risk": {"const": false}, "selected_skills": {"maxItems": 0}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "lean-two-file-fix"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "LEAN"}, "high_risk": {"const": false}, "skill": {"type": "null"}}},
        "actual": {"properties": {"workflow": {"const": "LEAN"}, "high_risk": {"const": false}, "selected_skills": {"maxItems": 0}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "strict-feature"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "skill": {"type": "null"}}},
        "actual": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "selected_skills": {"maxItems": 0}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "strict-readonly-architecture"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "skill": {"type": "null"}}},
        "actual": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "selected_skills": {"maxItems": 0}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "deep-architecture-implementation"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "DEEP"}, "high_risk": {"const": false}, "skill": {"const": "codex-baseline-deep-work"}}},
        "actual": {"properties": {"workflow": {"const": "DEEP"}, "high_risk": {"const": false}, "selected_skills": {"contains": {"const": "codex-baseline-deep-work"}}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "deep-auth-migration"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "DEEP"}, "high_risk": {"const": true}, "skill": {"const": "codex-baseline-deep-work"}}},
        "actual": {"properties": {"workflow": {"const": "DEEP"}, "high_risk": {"const": true}, "selected_skills": {"contains": {"const": "codex-baseline-deep-work"}}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "onboarding"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "DEEP"}, "high_risk": {"const": false}, "skill": {"const": "codex-baseline-repo-onboarding"}}},
        "actual": {"properties": {"workflow": {"const": "DEEP"}, "high_risk": {"const": false}, "selected_skills": {"contains": {"const": "codex-baseline-repo-onboarding"}}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "conformance"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "skill": {"const": "codex-baseline-conformance-review"}}},
        "actual": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "selected_skills": {"contains": {"const": "codex-baseline-conformance-review"}}}}
      }}
    },
    {
      "if": {"properties": {"pass": {"const": true}, "id": {"const": "retrospective"}}, "required": ["pass", "id"]},
      "then": {"properties": {
        "expected": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "skill": {"const": "codex-baseline-retrospective"}}},
        "actual": {"properties": {"workflow": {"const": "STRICT"}, "high_risk": {"const": false}, "selected_skills": {"contains": {"const": "codex-baseline-retrospective"}}}}
      }}
    }
  ]
}
