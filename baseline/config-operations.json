{
  "schema": 2,
  "contract": "codex-baseline-config-operations/v2",
  "core_operations_compat": "codex-baseline-operations/v1",
  "object_type": "toml-keys",
  "operations": ["install-cap", "optimize", "restore", "rollback", "uninstall"],
  "mutation_requires_apply": true,
  "install_exception": "absent-agent-cap-only",
  "managed_paths": [
    {"path": "agents.enabled", "type": "boolean"},
    {"path": "agents.max_concurrent_threads_per_session", "type": "integer"},
    {"path": "service_tier", "type": "enum", "values": ["fast"]},
    {"path": "features.fast_mode", "type": "boolean"}
  ],
  "user_override_paths": ["agents.enabled", "agents.max_concurrent_threads_per_session", "agents.max_threads", "features.multi_agent"],
  "states": ["planned", "prepared", "committing", "replaced-before-security", "committed", "rolled-back"],
  "transaction_journal_fields": {
    "unix": ["contract", "core_tx", "desired_acl_state", "desired_gid", "desired_mode", "desired_physical_hash", "desired_projection_hash", "desired_structure_hash", "desired_uid", "desired_xattr_state", "old", "operation", "ownership", "parent", "previous_acl_state", "previous_existed", "previous_gid", "previous_mode", "previous_physical_hash", "previous_projection_hash", "previous_structure_hash", "previous_uid", "previous_xattr_state", "schema", "stage", "stage_acl_state", "stage_gid", "stage_mode", "stage_physical_hash", "stage_uid", "stage_xattr_state", "state", "target", "version"],
    "windows": ["Schema", "Contract", "Id", "Operation", "Version", "CreatedUtc", "Parent", "CoreTransaction", "State", "Target", "Stage", "Old", "PreviousExisted", "PreviousPhysicalHash", "DesiredPhysicalHash", "PreviousProjectionHash", "DesiredProjectionHash", "PreviousStructureHash", "DesiredStructureHash", "PreviousIdentity", "PreviousSecurity", "DesiredIdentity", "DesiredSecurity", "Ownership"]
  },
  "ownership_entry_fields": {
    "unix": ["core_tx", "created_table", "installed_token", "path", "prior_file_existed", "prior_state", "prior_token", "separator_added", "type"],
    "windows": ["Id", "Path", "Table", "Type", "PriorState", "PriorToken", "PriorFileExisted", "InstalledToken", "CreatedTable", "SeparatorAdded", "PriorFinalNewline"]
  },
  "forbidden_journal_content": ["complete-config", "auth", "session", "secret-values"],
  "metadata": {
    "windows": "owner-dacl-protection; reject-sacl-claim-ads-reparse-hardlink",
    "unix": "owner-mode; reject-detected-unpreservable-acl-xattr-link"
  },
  "native_validation": "isolated-sanitized-CODEX_HOME",
  "concurrency_boundary": "cooperative-cas-not-hostile-writer-or-power-loss",
  "reports": {
    "doctor": "codex-baseline-doctor/v2",
    "onboarding": "codex-baseline-onboarding/v2",
    "benchmark": "codex-baseline-benchmark/v2",
    "optimize": "codex-baseline-optimize/v1",
    "routing_run": "codex-baseline-routing-run/v2",
    "routing_result": "codex-baseline-routing-result/v2",
    "routing_summary": "codex-baseline-routing-summary/v2",
    "behavior_result": "codex-baseline-behavior-result/v2"
  }
}
