{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow", "high_risk", "selected_skills", "reason"],
  "properties": {
    "workflow": { "enum": ["LEAN", "STRICT", "DEEP"] },
    "high_risk": { "type": "boolean" },
    "selected_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
  }
}
