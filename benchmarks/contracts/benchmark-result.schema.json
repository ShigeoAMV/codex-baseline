{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-baseline.invalid/benchmarks/contracts/benchmark-result-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "class", "parallelism_class", "expected_lanes", "arm", "arm_order_position", "cache_state", "repetition", "pass", "first_pass", "first_pass_verification", "first_pass_provenance", "user_interventions", "user_interventions_verification", "user_interventions_provenance", "safety_violation", "safety_verification", "safety_provenance", "authority_violation", "authority_verification", "authority_provenance", "scope_violation", "scope_verification", "scope_provenance", "process_exit", "verifier_exit", "elapsed_ms", "turns", "commands", "file_changes", "changed_files", "unnecessary_files", "changed_paths", "unnecessary_paths", "failed_command_events", "raw_subagent_events", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "usage_scope", "cost_usd", "baseline_layer_bytes", "retry_count", "review_findings", "last_message_bytes", "added_lines", "added_code_lines", "added_comment_lines", "added_prose_lines", "added_blank_lines", "duplicate_added_lines", "pure_comment_diff", "hygiene_verification", "hygiene_provenance", "release_version", "payload_hash", "evaluation_profile", "evaluation_profile_hash", "auto_overlay_hash", "agent_guidance_hash", "configured_agent_cap", "orchestration", "isolation", "source_hash", "layer_hash", "arm_config_hash", "fixture_hash", "prompt_hash", "verifier_hash"],
  "properties": {
    "schema": {"const": 2},
    "task": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "class": {"enum": ["small", "medium", "large", "risk-sensitive"]},
    "parallelism_class": {"enum": ["parallel-positive", "serial-negative"]},
    "expected_lanes": {"type": "integer", "minimum": 0, "maximum": 6},
    "arm": {"enum": ["vanilla", "baseline-solo", "auto-homogeneous", "auto-routed"]},
    "arm_order_position": {"type": "integer", "minimum": 1, "maximum": 4},
    "cache_state": {"enum": ["first", "subsequent"]},
    "repetition": {"type": "integer", "minimum": 1},
    "pass": {"type": "boolean"},
    "first_pass": {"type": ["boolean", "null"]},
    "first_pass_verification": {"$ref": "#/$defs/truthVerification"},
    "first_pass_provenance": {"type": ["string", "null"], "minLength": 1},
    "user_interventions": {"type": ["integer", "null"], "minimum": 0},
    "user_interventions_verification": {"$ref": "#/$defs/truthVerification"},
    "user_interventions_provenance": {"type": ["string", "null"], "minLength": 1},
    "safety_violation": {"type": ["boolean", "null"]},
    "safety_verification": {"$ref": "#/$defs/truthVerification"},
    "safety_provenance": {"type": ["string", "null"], "minLength": 1},
    "authority_violation": {"type": ["boolean", "null"]},
    "authority_verification": {"$ref": "#/$defs/truthVerification"},
    "authority_provenance": {"type": ["string", "null"], "minLength": 1},
    "scope_violation": {"type": "boolean"},
    "scope_verification": {"const": "verified"},
    "scope_provenance": {"type": "string", "minLength": 1},
    "process_exit": {"type": "integer", "minimum": 0},
    "verifier_exit": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "turns": {"type": "integer", "minimum": 0},
    "commands": {"type": "integer", "minimum": 0},
    "file_changes": {"type": "integer", "minimum": 0},
    "changed_files": {"type": "integer", "minimum": 0},
    "unnecessary_files": {"type": "integer", "minimum": 0},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unnecessary_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "failed_command_events": {"type": "integer", "minimum": 0},
    "raw_subagent_events": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "usage_scope": {"enum": ["aggregate", "aggregate-unpriced", "parent-only", "unverified"]},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "baseline_layer_bytes": {"type": "integer", "minimum": 0},
    "retry_count": {"type": ["integer", "null"], "minimum": 0},
    "review_findings": {"type": ["integer", "null"], "minimum": 0},
    "last_message_bytes": {"type": "integer", "minimum": 0},
    "added_lines": {"type": "integer", "minimum": 0},
    "added_code_lines": {"type": "integer", "minimum": 0},
    "added_comment_lines": {"type": "integer", "minimum": 0},
    "added_prose_lines": {"type": "integer", "minimum": 0},
    "added_blank_lines": {"type": "integer", "minimum": 0},
    "duplicate_added_lines": {"type": "integer", "minimum": 0},
    "pure_comment_diff": {"type": "boolean"},
    "hygiene_verification": {"const": "verified"},
    "hygiene_provenance": {"const": "host-git-diff-objective/v1"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_profile": {"enum": ["vanilla", "baseline-solo", "auto-homogeneous", "auto-routed"]},
    "evaluation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "auto_overlay_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "agent_guidance_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "configured_agent_cap": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
    "orchestration": {"$ref": "#/$defs/orchestration"},
    "isolation": {"const": "os-sandboxed-local-cgroup"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layer_hash": {"type": "string", "pattern": "^(vanilla|[0-9a-f]{64})$"},
    "arm_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "verification": {"enum": ["verified", "partial", "unverified"]},
    "truthVerification": {"enum": ["verified", "unverified"]},
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "lane_id", "requested_model", "actual_model", "requested_effort", "actual_effort", "status"],
      "properties": {"id": {"type": "string"}, "lane_id": {"type": ["string", "null"]}, "requested_model": {"type": ["string", "null"]}, "actual_model": {"type": ["string", "null"]}, "requested_effort": {"type": ["string", "null"]}, "actual_effort": {"type": ["string", "null"]}, "status": {"enum": ["spawned", "completed", "failed", "interrupted", "timeout", "unverified"]}}
    },
    "settings": {
      "type": "object", "additionalProperties": false, "required": ["model", "effort", "speed"],
      "properties": {"model": {"type": ["string", "null"]}, "effort": {"type": ["string", "null"]}, "speed": {"type": ["string", "null"]}}
    },
    "orchestration": {
      "type": "object", "additionalProperties": false,
      "required": ["execution", "selection_reason", "planned_lane_ids", "planned_fanout", "actual_fanout", "available_capacity", "agents", "depth_intended", "depth_observed", "depth_verification", "waves_planned", "waves_observed", "waves_verification", "peak_concurrency", "peak_concurrency_verification", "spawn_errors", "fallbacks", "interrupts", "timeouts", "conflicts", "integration_rework_events", "handoff_bytes", "duplicated_context_bytes", "write_isolation", "test_isolation", "parent_before", "parent_after", "parent_settings_verification", "telemetry_verification", "telemetry_adapter_hash", "telemetry_provenance"],
      "properties": {
        "execution": {"type": ["string", "null"], "enum": ["SOLO", "TEAM", "SWARM", null]},
        "selection_reason": {"type": ["string", "null"]},
        "planned_lane_ids": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "planned_fanout": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
        "actual_fanout": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
        "available_capacity": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
        "agents": {"type": ["array", "null"], "items": {"$ref": "#/$defs/agent"}},
        "depth_intended": {"const": 1}, "depth_observed": {"type": ["integer", "null"], "minimum": 0}, "depth_verification": {"$ref": "#/$defs/verification"},
        "waves_planned": {"type": ["integer", "null"], "minimum": 0, "maximum": 4}, "waves_observed": {"type": ["integer", "null"], "minimum": 0}, "waves_verification": {"$ref": "#/$defs/verification"},
        "peak_concurrency": {"type": ["integer", "null"], "minimum": 0}, "peak_concurrency_verification": {"$ref": "#/$defs/verification"},
        "spawn_errors": {"type": ["array", "null"], "items": {"type": "string"}}, "interrupts": {"type": ["integer", "null"], "minimum": 0}, "timeouts": {"type": ["integer", "null"], "minimum": 0}, "fallbacks": {"type": ["integer", "null"], "minimum": 0}, "conflicts": {"type": ["integer", "null"], "minimum": 0}, "integration_rework_events": {"type": ["integer", "null"], "minimum": 0},
        "handoff_bytes": {"type": ["integer", "null"], "minimum": 0}, "duplicated_context_bytes": {"type": ["integer", "null"], "minimum": 0},
        "write_isolation": {"enum": ["read-only", "single-writer", "verified-worktrees", "unverified"]}, "test_isolation": {"enum": ["isolated", "serial", "unverified"]},
        "parent_before": {"$ref": "#/$defs/settings"}, "parent_after": {"$ref": "#/$defs/settings"}, "parent_settings_verification": {"$ref": "#/$defs/verification"}, "telemetry_verification": {"$ref": "#/$defs/verification"},
        "telemetry_adapter_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "telemetry_provenance": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"telemetry_verification": {"const": "verified"}}}, "then": {"properties": {"telemetry_adapter_hash": {"type": "string"}, "telemetry_provenance": {"type": "string"}, "execution": {"type": "string"}, "selection_reason": {"type": "string", "minLength": 1}, "planned_lane_ids": {"type": "array"}, "planned_fanout": {"type": "integer"}, "actual_fanout": {"type": "integer"}, "available_capacity": {"type": "integer"}, "agents": {"type": "array"}, "depth_observed": {"type": "integer"}, "depth_verification": {"const": "verified"}, "waves_observed": {"type": "integer"}, "waves_verification": {"const": "verified"}, "peak_concurrency": {"type": "integer"}, "peak_concurrency_verification": {"const": "verified"}, "spawn_errors": {"type": "array"}, "fallbacks": {"type": "integer"}, "interrupts": {"type": "integer"}, "timeouts": {"type": "integer"}, "conflicts": {"type": "integer"}, "integration_rework_events": {"type": "integer"}, "handoff_bytes": {"type": "integer"}, "duplicated_context_bytes": {"type": "integer"}, "parent_settings_verification": {"const": "verified"}}}, "else": {"if": {"properties": {"telemetry_verification": {"const": "partial"}}}, "then": {"properties": {"telemetry_adapter_hash": {"type": ["string", "null"]}, "telemetry_provenance": {"type": ["string", "null"]}}}, "else": {"properties": {"telemetry_adapter_hash": {"type": "null"}, "telemetry_provenance": {"type": "null"}}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"pass": {"const": true}}}, "then": {"properties": {"process_exit": {"const": 0}, "verifier_exit": {"const": 0}}}},
    {"if": {"properties": {"process_exit": {"const": 0}, "verifier_exit": {"const": 0}}}, "then": {"properties": {"pass": {"const": true}}}},
    {"if": {"properties": {"first_pass_verification": {"const": "verified"}}}, "then": {"properties": {"first_pass": {"type": "boolean"}, "first_pass_provenance": {"type": "string"}}}, "else": {"properties": {"first_pass": {"type": "null"}, "first_pass_provenance": {"type": "null"}}}},
    {"if": {"properties": {"user_interventions_verification": {"const": "verified"}}}, "then": {"properties": {"user_interventions": {"type": "integer"}, "user_interventions_provenance": {"type": "string"}}}, "else": {"properties": {"user_interventions": {"type": "null"}, "user_interventions_provenance": {"type": "null"}}}},
    {"if": {"properties": {"safety_verification": {"const": "verified"}}}, "then": {"properties": {"safety_violation": {"type": "boolean"}, "safety_provenance": {"type": "string"}}}, "else": {"properties": {"safety_violation": {"type": "null"}, "safety_provenance": {"type": "null"}}}},
    {"if": {"properties": {"authority_verification": {"const": "verified"}}}, "then": {"properties": {"authority_violation": {"type": "boolean"}, "authority_provenance": {"type": "string"}}}, "else": {"properties": {"authority_violation": {"type": "null"}, "authority_provenance": {"type": "null"}}}},
    {"if": {"properties": {"usage_scope": {"const": "aggregate"}}}, "then": {"properties": {"input_tokens": {"type": "integer"}, "cached_input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "reasoning_tokens": {"type": "integer"}, "cost_usd": {"type": "number"}}}},
    {"if": {"properties": {"usage_scope": {"const": "aggregate-unpriced"}}}, "then": {"properties": {"input_tokens": {"type": "integer"}, "cached_input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}, "reasoning_tokens": {"type": "integer"}, "cost_usd": {"type": "null"}}}},
    {"if": {"properties": {"usage_scope": {"const": "unverified"}}}, "then": {"properties": {"input_tokens": {"type": "null"}, "cached_input_tokens": {"type": "null"}, "output_tokens": {"type": "null"}, "reasoning_tokens": {"type": "null"}, "cost_usd": {"type": "null"}}}},
    {"if": {"properties": {"first_pass": {"const": true}}}, "then": {"properties": {"pass": {"const": true}}}},
    {"if": {"properties": {"parallelism_class": {"const": "serial-negative"}}}, "then": {"properties": {"expected_lanes": {"const": 0}}}},
    {"if": {"properties": {"parallelism_class": {"const": "parallel-positive"}}}, "then": {"properties": {"expected_lanes": {"type": "integer", "minimum": 2, "maximum": 6}}}},
    {"if": {"properties": {"arm": {"enum": ["auto-homogeneous", "auto-routed"]}, "parallelism_class": {"const": "serial-negative"}, "orchestration": {"properties": {"telemetry_verification": {"const": "verified"}}}}}, "then": {"properties": {"orchestration": {"properties": {"execution": {"const": "SOLO"}, "planned_fanout": {"const": 0}, "planned_lane_ids": {"type": "array", "maxItems": 0}}}}}},
    {"if": {"properties": {"arm": {"enum": ["auto-homogeneous", "auto-routed"]}, "expected_lanes": {"const": 2}, "orchestration": {"properties": {"telemetry_verification": {"const": "verified"}}}}}, "then": {"properties": {"orchestration": {"properties": {"execution": {"const": "TEAM"}, "planned_fanout": {"const": 2}, "planned_lane_ids": {"type": "array", "minItems": 2, "maxItems": 2}}}}}},
    {"if": {"properties": {"arm": {"enum": ["auto-homogeneous", "auto-routed"]}, "expected_lanes": {"const": 3}, "orchestration": {"properties": {"telemetry_verification": {"const": "verified"}}}}}, "then": {"properties": {"orchestration": {"properties": {"execution": {"const": "TEAM"}, "planned_fanout": {"const": 3}, "planned_lane_ids": {"type": "array", "minItems": 3, "maxItems": 3}}}}}},
    {"if": {"properties": {"arm": {"enum": ["auto-homogeneous", "auto-routed"]}, "expected_lanes": {"const": 4}, "orchestration": {"properties": {"telemetry_verification": {"const": "verified"}}}}}, "then": {"properties": {"orchestration": {"properties": {"execution": {"const": "SWARM"}, "planned_fanout": {"const": 4}, "planned_lane_ids": {"type": "array", "minItems": 4, "maxItems": 4}}}}}},
    {"if": {"properties": {"arm": {"enum": ["auto-homogeneous", "auto-routed"]}, "expected_lanes": {"const": 5}, "orchestration": {"properties": {"telemetry_verification": {"const": "verified"}}}}}, "then": {"properties": {"orchestration": {"properties": {"execution": {"const": "SWARM"}, "planned_fanout": {"const": 5}, "planned_lane_ids": {"type": "array", "minItems": 5, "maxItems": 5}}}}}},
    {"if": {"properties": {"arm": {"enum": ["auto-homogeneous", "auto-routed"]}, "expected_lanes": {"const": 6}, "orchestration": {"properties": {"telemetry_verification": {"const": "verified"}}}}}, "then": {"properties": {"orchestration": {"properties": {"execution": {"const": "SWARM"}, "planned_fanout": {"const": 6}, "planned_lane_ids": {"type": "array", "minItems": 6, "maxItems": 6}}}}}},
    {"if": {"properties": {"arm": {"const": "vanilla"}}}, "then": {"properties": {"evaluation_profile": {"const": "vanilla"}, "auto_overlay_hash": {"type": "null"}, "agent_guidance_hash": {"type": "null"}, "configured_agent_cap": {"type": "null"}}}},
    {"if": {"properties": {"arm": {"const": "baseline-solo"}}}, "then": {"properties": {"evaluation_profile": {"const": "baseline-solo"}, "auto_overlay_hash": {"type": "null"}, "agent_guidance_hash": {"type": "string"}, "configured_agent_cap": {"const": 0}}}},
    {"if": {"properties": {"arm": {"const": "auto-homogeneous"}}}, "then": {"properties": {"evaluation_profile": {"const": "auto-homogeneous"}, "auto_overlay_hash": {"type": "string"}, "agent_guidance_hash": {"type": "string"}, "configured_agent_cap": {"const": 6}}}},
    {"if": {"properties": {"arm": {"const": "auto-routed"}}}, "then": {"properties": {"evaluation_profile": {"const": "auto-routed"}, "auto_overlay_hash": {"type": "string"}, "agent_guidance_hash": {"type": "string"}, "configured_agent_cap": {"const": 6}}}}
  ]
}
